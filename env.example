# Server
SERVER_PORT=8080

# Database
DB_URL=jdbc:postgresql://localhost:5432/fsoft_erp
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Admin init
ADMIN_USER_NAME=catsocute@info.com
ADMIN_PASSWORD=catsocute

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# QR signer key (uc-c-02). Optional: if unset, the JWT signer key is used.
# Use a >= 64-byte value so it is valid for HS512.
QR_SIGNER_KEY=

# OTP signer key (uc-c-03). Optional: if unset, the JWT signer key is used.
# Used for OTP code HMAC and OTP ticket signing (>= 64 bytes for HS512).
OTP_SIGNER_KEY=
